---
import ActionLink from "@/components/shared/ActionLink.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="The page you were looking for could not be found. Explore carfdev's projects or return to the homepage."
>
  <section
    aria-labelledby="not-found-title"
    class="content-container flex w-full flex-col items-start gap-6 py-12 md:gap-8 md:py-18"
  >
    <!-- Section label -->
    <p class="font-mono text-xs tracking-mono text-secondary">
      404 / PAGE NOT FOUND
    </p>

    <!-- Main heading -->
    <h1
      id="not-found-title"
      class="text-title-fluid font-medium text-primary text-balance"
    >
      Nothing at
      <br />
      this address.
    </h1>

    <!-- Description -->
    <p class="max-w-187.5 text-lg leading-relaxed text-secondary md:text-2xl">
      This page may have moved, or the link may be incorrect. The projects are
      still a good place to start.
    </p>

    <!-- Navigation -->
    <div class="flex flex-wrap items-center gap-x-8 gap-y-5">
      <!-- Primary action -->
      <ActionLink
        href="/projects"
        class="gap-7 bg-accent px-6 py-4 text-sm font-medium text-white transition-colors hover:bg-primary focus-visible:outline-accent"
        appearance="button"
      >
        <span>Explore projects</span>
      </ActionLink>

      <!-- Secondary action -->
      <a
        href="/"
        class="link-underline group inline-flex w-fit items-center gap-2 text-sm font-medium text-primary transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
      >
        <span>Back to home</span>
      </a>
    </div>
  </section>
</Layout>
