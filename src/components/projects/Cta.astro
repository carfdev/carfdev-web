---
import ActionLink from "@/components/shared/ActionLink.astro";
import { site } from "@/data/site";
---

<aside
  aria-label="More projects on GitHub"
  class="w-full border-t border-border"
>
  <div class="content-container flex flex-col items-start justify-between gap-4.5 py-7 md:flex-row md:items-center md:gap-8 md:py-9">
    <p class="max-w-2xl text-xl leading-relaxed text-secondary">
      More experiments, templates and work in progress.
    </p>

    <ActionLink
      href={site.github.href}
      target="_blank"
      rel="noopener noreferrer"
      class="w-fit shrink-0 gap-2 text-lg font-medium text-accent transition-colors hover:text-primary focus-visible:outline-accent"
      arrow="up-right"
    >
      <span>All repositories</span>
    </ActionLink>
  </div>
</aside>
