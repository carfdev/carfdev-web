---
import { site } from "@/data/site";
---

<aside
  aria-label="More projects on GitHub"
  class="w-full border-t border-border"
>
  <div class="content-container flex flex-col items-start justify-between gap-4.5 py-7 md:flex-row md:items-center md:gap-8 md:py-9">
    <p class="max-w-2xl text-xl leading-relaxed text-secondary">
      More experiments, templates and work in progress.
    </p>

    <a
      href={site.github.href}
      target="_blank"
      rel="noopener noreferrer"
      class="link-underline group inline-flex w-fit shrink-0 items-center gap-2 text-lg font-medium text-accent transition-colors duration-200 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
    >
      <span>All repositories</span>

      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 motion-reduce:transition-none"
      >
        ↗
      </span>
    </a>
  </div>
</aside>
