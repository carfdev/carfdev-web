---
interface Props {
  number: string;
  name: string;
  title: string;
  description: string;
  technologies: string[];
  href: string;
}

const { number, name, title, description, technologies, href } = Astro.props;

const headingId = `project-${number}`;
---

<article aria-labelledby={headingId} class="border-t border-border">
  <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4 gap-y-5 py-8 lg:grid-cols-[2.5rem_minmax(14rem,21.875rem)_minmax(0,1fr)] lg:gap-x-8 lg:py-9">
    <!-- Number -->
    <span
      aria-hidden="true"
      class="pt-1 font-mono text-xs tracking-mono text-secondary"
    >
      {number}
    </span>

    <!-- Project identity -->
    <div class="flex min-w-0 flex-col gap-3">
      <h2
        id={headingId}
        class="text-2xl font-medium tracking-tight text-primary lg:text-[28px]"
      >
        {name}
      </h2>

      <p class="text-sm leading-relaxed text-secondary">{title}</p>
    </div>

    <!-- Project details -->
    <div class="col-start-2 flex min-w-0 flex-col items-start gap-4.5 lg:col-start-3">
      <p class="leading-relaxed text-secondary md:text-lg">{description}</p>

      <p class="font-mono text-xs leading-relaxed text-primary md:text-sm">
        {technologies.join(" · ")}
      </p>

      <a
        href={href}
        aria-label={`Explore project: ${name}`}
        class="link-underline group inline-flex w-fit items-center gap-2 text-sm font-medium text-accent transition-colors duration-200 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
      >
        <span>Explore project</span>

        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
        >
          →
        </span>
      </a>
    </div>
  </div>
</article>
