---
import { getProjects } from "@/lib/projects";
import Project from "./Project.astro";

const projects = await getProjects();
---

<section
  aria-label="Project list"
  class="content-container w-full pb-8 md:pb-16"
>
  <ol class="flex list-none flex-col" role="list">
    {projects.map((project, index) => (
      <li>
        <Project
          number={String(index + 1).padStart(2, "0")}
          name={project.data.title}
          title={project.data.card.subtitle}
          description={project.data.card.description}
          technologies={project.data.card.technologies}
          href={`/projects/${project.id}`}
        />
      </li>
    ))}
  </ol>
</section>
