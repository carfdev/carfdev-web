<section aria-labelledby="contact-cta-title" class="bg-base-accent">
  <div class="mx-auto grid w-full max-w-360 grid-cols-1 gap-6 px-6 py-12 md:px-20 md:py-16 lg:grid-cols-[minmax(0,25rem)_minmax(0,1fr)] lg:gap-16">
    <!-- Heading -->
    <h2
      id="contact-cta-title"
      class="max-w-100 text-cta-fluid font-medium text-primary text-balance"
    >
      No perfect pitch needed.
    </h2>

    <!-- Description and link -->
    <div class="flex min-w-0 flex-col items-start gap-5">
      <p class="max-w-175 text-lg leading-relaxed text-secondary md:text-xl">
        A short introduction to your team, the role or project, and what you’d
        like to discuss is plenty.
      </p>

      <a
        href="/projects"
        class="link-underline group inline-flex w-fit items-center gap-2 text-sm font-medium text-accent transition-colors duration-200 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
      >
        <span>Get to know my work</span>

        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
        >
          →
        </span>
      </a>
    </div>
  </div>
</section>
