---
interface Props {
  scope: { title: string; description: string };
}
const { scope } = Astro.props;
---

<section aria-labelledby="project-scope-title" class="bg-base-accent">
  <div class="content-container flex w-full flex-col gap-5 py-10 md:gap-6 md:py-14">
    <p class="font-mono text-xs tracking-mono text-secondary">CURRENT SCOPE</p>
    <h2
      id="project-scope-title"
      class="max-w-240 text-cta-fluid font-medium text-primary text-balance"
    >
      {scope.title}
    </h2>
    <p class="max-w-240 text-lg leading-relaxed text-secondary md:text-xl">
      {scope.description}
    </p>
  </div>
</section>
