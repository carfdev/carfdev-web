---
import ActionLink from "@/components/shared/ActionLink.astro";
interface Props {
  nextProject: { title: string; href: string } | null;
}
const { nextProject } = Astro.props;
const href = nextProject?.href ?? "/projects";
const label = nextProject?.title ?? "All personal projects";
---

<nav
  aria-label="Project navigation"
  class="content-container flex w-full flex-col gap-4 py-9 md:flex-row md:items-center md:justify-between md:gap-8 md:py-12"
>
  <p class="font-mono text-xs tracking-mono text-secondary">
    {nextProject ? "NEXT PROJECT" : "KEEP EXPLORING"}
  </p>
  <ActionLink
    href={href}
    arrowClass="shrink-0"
    class="w-fit max-w-full gap-2 text-2xl font-medium tracking-tight text-accent transition-colors hover:text-primary focus-visible:outline-accent md:text-3xl"
  >
    <span>{label}</span>
  </ActionLink>
</nav>
