---
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---

<section
  aria-label="Project metadata"
  class="content-container w-full border-t border-border py-7 md:py-9"
>
  <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12">
    {items.map(({ label, value }) => (
      <div class="flex min-w-0 flex-col gap-2.5">
        <dt class="font-mono text-xs tracking-mono text-secondary">{label}</dt>
        <dd class="text-base leading-relaxed text-primary md:text-lg">
          {value}
        </dd>
      </div>
    ))}
  </dl>
</section>
