---
import ActionLink from "@/components/shared/ActionLink.astro";
import { site } from "@/data/site";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">["data"];
}

const { project } = Astro.props;
const repoHref = project.repository ?? site.github.href;
const repoLabel = project.repository
  ? "View source on GitHub"
  : "Browse GitHub repositories";
---

<section
  aria-labelledby="project-title"
  class="content-container flex w-full flex-col items-start gap-6 pt-10 pb-9 md:gap-7 md:pt-16 md:pb-14"
>
  <a
    href="/projects"
    class="link-underline inline-flex w-fit items-center gap-2 text-sm text-secondary transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
  >
    <span aria-hidden="true">←</span>
    <span>All projects</span>
  </a>

  <p class="font-mono text-[10px] leading-relaxed tracking-mono text-secondary md:text-xs">
    {project.category}
  </p>

  <h1
    id="project-title"
    class="min-w-0 max-w-full text-project-fluid font-medium text-primary text-balance wrap-anywhere"
  >
    {project.title}
  </h1>

  <p class="max-w-217.5 text-xl leading-relaxed text-secondary md:text-2xl">
    {project.description}
  </p>

  <div class="flex flex-wrap items-center gap-x-7 gap-y-5">
    <ActionLink
      href={repoHref}
      target="_blank"
      rel="noopener noreferrer"
      class="w-fit gap-8 bg-accent px-5.5 py-4 text-sm font-medium text-white transition-colors hover:bg-primary focus-visible:outline-accent"
      appearance="button"
      arrow="up-right"
    >
      <span>{repoLabel}</span>
    </ActionLink>

    {project.demo && (
      <ActionLink
        href={project.demo}
        target="_blank"
        rel="noopener noreferrer"
        class="w-fit gap-2 text-[1rem] leading-6 font-medium text-accent transition-colors hover:text-primary focus-visible:outline-accent"
        arrow="up-right"
        distance="small"
      >
        <span>Open live demo</span>
      </ActionLink>
    )}
  </div>
</section>
