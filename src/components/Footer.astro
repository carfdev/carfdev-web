---
import ActionLink from "@/components/shared/ActionLink.astro";
import { emailHref, locationLabel, site } from "@/data/site";
---

<footer class="content-container flex w-full flex-col gap-7.5 pt-12 pb-7 md:gap-8.5 md:pt-20 md:pb-14">
  <p class="font-mono text-xs tracking-mono text-secondary">03 / CONTACT</p>

  <div class="flex flex-col items-start justify-between gap-9 md:flex-row md:items-end md:gap-12">
    <div class="flex max-w-175 flex-col gap-6">
      <h2 class="text-subtitle-fluid font-medium text-primary">
        Let’s build
        <br />
        something solid.
      </h2>

      <p class="text-lg text-secondary">
        I’m looking for my first developer role. Let’s talk about your team.
      </p>
    </div>

    <address class="flex min-w-0 flex-col gap-4.5 not-italic">
      <!-- Email -->
      <ActionLink
        href={emailHref}
        arrowClass="shrink-0"
        class="w-fit max-w-full gap-2 text-[clamp(1.375rem,5vw,1.875rem)] tracking-logo text-accent transition-colors hover:text-primary focus-visible:outline-accent"
        arrow="up-right"
      >
        <span>{site.email}</span>
      </ActionLink>

      <!-- Phone -->
      <a
        href={site.phone.href}
        class="link-underline w-fit text-sm text-primary transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
      >
        {site.phone.label}
      </a>

      <p class="text-sm text-secondary">{locationLabel}</p>
    </address>
  </div>

  <div class="h-px bg-border"></div>

  <div class="flex items-center justify-between gap-4">
    <!-- Logo -->
    <a
      href="/"
      class="text-xl font-semibold tracking-logo text-primary transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
    >
      {site.name}
    </a>

    <p class="hidden font-mono text-xs tracking-mono text-secondary md:block">
      FULLSTACK / {site.location.city.toUpperCase()}
    </p>

    <!-- GitHub -->
    <ActionLink
      href={site.github.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub (opens in a new tab)"
      class="w-fit gap-1 text-sm text-secondary transition-colors hover:text-primary focus-visible:outline-accent"
      arrow="up-right"
      distance="small"
    >
      <span>GitHub</span>
    </ActionLink>
  </div>
</footer>
