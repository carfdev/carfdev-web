---
import ActionLink from "@/components/shared/ActionLink.astro";
import type { ComponentProps } from "astro/types";
import { getProjects } from "@/lib/projects";
import { projectReference } from "@/lib/project-data";
import CodeItem from "./CodeItem.astro";

type Project = ComponentProps<typeof CodeItem>;

const collection = await getProjects();
const projects = [
  {
    ...projectReference(collection, "invoice-api"),
    technologies: ["Rust", "Axum", "mTLS"],
  },
  {
    ...projectReference(collection, "carfdev-gateway"),
    technologies: ["Go", "Gin", "NATS"],
  },
  {
    ...projectReference(collection, "foodi"),
    technologies: ["Astro", "Vue", "Tailwind CSS"],
  },
] satisfies Project[];
---

<section aria-labelledby="projects-title" class="bg-primary">
  <div class="content-container flex flex-col gap-2 py-11 md:gap-5 md:py-16">
    <!-- Section index -->
    <p class="font-mono text-xs tracking-mono text-primary-foreground">
      02 / CODE
    </p>

    <!-- Section header -->
    <header class="flex flex-col gap-7 md:flex-row md:items-end md:justify-between md:gap-8">
      <div class="flex max-w-177.5 flex-col gap-4.5">
        <h2
          id="projects-title"
          class="text-h3-fluid font-medium text-white text-balance"
        >
          Personal projects.
          <br />
          Practical learning.
        </h2>

        <p class="text-lg leading-relaxed text-primary-foreground md:text-xl">
          A few things I've built to explore how the web works, from the
          interface to the infrastructure.
        </p>
      </div>

      <ActionLink
        href="/projects"
        class="w-fit shrink-0 gap-2 text-sm font-medium text-white transition-opacity hover:opacity-70 focus-visible:outline-white"
        appearance="plain"
        arrow="up-right"
        distance="small"
      >
        <span>All projects</span>
      </ActionLink>
    </header>

    <!-- Projects -->
    <ul class="flex flex-col gap-2 md:gap-5">
      {projects.map((project) => (
        <li>
          <CodeItem {...project} />
        </li>
      ))}
    </ul>

    <!-- Section footer -->
    <p class="border-t border-border-foreground pt-5 font-mono text-xs leading-relaxed tracking-mono text-primary-foreground">
      SELECTED PERSONAL PROJECTS / SOURCE ON GITHUB
    </p>
  </div>
</section>
