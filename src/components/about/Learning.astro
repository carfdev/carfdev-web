---
import type { ComponentProps } from "astro/types";
import { getProjects } from "@/lib/projects";
import { projectReference } from "@/lib/project-data";
import LearningItem from "./LearningItem.astro";

type Learning = Omit<ComponentProps<typeof LearningItem>, "number">;

const collection = await getProjects();
const learnings = [
  {
    title: "Clear interfaces",
    description:
      "Turning a design into a responsive website, then adding the interactions that make it useful.",
    ...projectReference(collection, "foodi"),
    technologies: ["Astro", "Vue"],
  },
  {
    title: "Explicit boundaries",
    description:
      "Exploring where application logic, persistence and authentication belong in an API.",
    ...projectReference(collection, "invoice-api"),
    technologies: ["Rust", "mTLS"],
  },
  {
    title: "Connected systems",
    description:
      "Following a request from an HTTP endpoint through messaging to a separate service.",
    ...projectReference(collection, "carfdev-gateway"),
    technologies: ["Go", "NATS"],
  },
] satisfies Learning[];
---

<section
  aria-labelledby="learning-title"
  class="content-container flex w-full flex-col gap-9 border-t border-border pt-14 pb-18 md:gap-11 md:pt-18 md:pb-20"
>
  <!-- Section heading -->
  <header class="flex flex-col gap-4">
    <p class="font-mono text-xs tracking-mono text-secondary">
      WHAT I’M EXPLORING
    </p>

    <h2
      id="learning-title"
      class="text-h3-fluid font-medium text-primary text-balance"
    >
      Not just how. Why.
    </h2>
  </header>

  <!-- Learning items -->
  <ol class="flex list-none flex-col gap-8 md:gap-11" role="list">
    {learnings.map((item, index) => (
      <li>
        <LearningItem number={String(index + 1).padStart(2, "0")} {...item} />
      </li>
    ))}
  </ol>
</section>
