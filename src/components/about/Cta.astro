---
import ActionLink from "@/components/shared/ActionLink.astro";
---

<section aria-labelledby="next-chapter-title" class="bg-primary">
  <div class="content-container flex w-full flex-col items-start gap-6 py-12 md:gap-7 md:py-16">
    <!-- Section label -->
    <p class="font-mono text-xs tracking-mono text-primary-foreground">
      THE NEXT CHAPTER
    </p>

    <!-- Heading -->
    <h2
      id="next-chapter-title"
      class="text-h3-fluid font-medium text-white text-balance"
    >
      A first role. A real team.
    </h2>

    <!-- Description -->
    <p class="max-w-212.5 text-lg leading-relaxed text-primary-foreground md:text-xl">
      I’m looking for an opportunity to contribute to real products, learn from
      code reviews, and grow alongside other developers.
    </p>

    <!-- CTA -->
    <ActionLink
      href="/contact"
      class="w-fit gap-2 text-lg font-medium text-white transition-colors hover:text-primary-foreground focus-visible:outline-white"
    >
      <span>Let’s talk</span>
    </ActionLink>
  </div>
</section>
