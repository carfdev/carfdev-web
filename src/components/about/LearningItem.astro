---
interface Props {
  number: string;
  title: string;
  description: string;
  name: string;
  technologies: string[];
  href: string;
}

const { number, title, description, name, technologies, href } = Astro.props;
---

<div class="border-t border-border pt-6">
  <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4 gap-y-5 lg:grid-cols-[2.5rem_minmax(14rem,20.625rem)_minmax(0,1fr)] lg:gap-x-8">
    <!-- Number -->
    <span
      aria-hidden="true"
      class="pt-1 font-mono text-xs tracking-mono text-secondary"
    >
      {number}
    </span>

    <!-- Title -->
    <h3 class="min-w-0 text-2xl font-medium tracking-tight text-primary lg:text-[28px]">
      {title}
    </h3>

    <!-- Description and project reference -->
    <div class="col-start-2 flex min-w-0 flex-col gap-4 lg:col-start-3">
      <p class="leading-relaxed text-secondary md:text-lg">{description}</p>

      <p class="font-mono text-xs leading-relaxed tracking-mono text-secondary">
        <a
          href={href}
          class="text-primary underline underline-offset-4 transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
        >
          {name}
        </a>
        {" / "} {technologies.join(" + ")}
      </p>
    </div>
  </div>
</div>
