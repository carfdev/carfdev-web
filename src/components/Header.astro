---
import { site } from "@/data/site";
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
] as const;

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="content-container flex w-full flex-col items-start justify-between gap-5 py-6 text-primary xs:flex-row xs:items-center xs:gap-0 xs:py-8">
  <a
    href="/"
    aria-current={currentPath === "/" ? "page" : undefined}
    class="whitespace-nowrap text-2xl font-semibold tracking-logo transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
  >
    {site.name}
  </a>

  <nav
    class="flex shrink-0 items-center gap-8 whitespace-nowrap text-sm"
    aria-label="Main navigation"
  >
    {links.map(({ label, href }) => (
      <a
        href={href}
        aria-current={currentPath === href ? "page" : undefined}
        class:list={[
          "link-underline transition-colors duration-200",
          "hover:text-accent",
          "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",
          "motion-reduce:transition-none",
          isActive(href) && "nav-link-active font-medium text-accent",
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
</header>

<style>
  .nav-link-active::after {
    transform: scaleX(1);
  }
</style>
